# ==========================================
# ISS Chile Pepper Microbiome - .gitignore
# ==========================================

# Manuscript files & generation script (regenerate via script)
18_create_manuscript.py
*.docx
manuscript*.pdf
Supplementary*.docx
Supplementary*.pdf

# Large extracted images (original source files)
*.tiff
*.tif
current_biology/extracted_image*

# Raw sequencing data (download via 00_download_data.py)
external_data/
*.fastq.gz
*.fastq

# QIIME2 artifacts (large binary files, generated by 05_qiime2_pipeline.sh)
version-2_integrated/*.qza
version-2_integrated/*.qzv
version-2_integrated/demux.qza

# Exported BIOM files (TSV versions are tracked instead)
*.biom

# PICRUSt2 intermediate files
version-2_integrated/picrust2_out/intermediate/
version-2_integrated/picrust2_out/marker_predicted_and_nsti.tsv.gz

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Conda / Virtual environments (use envs/*.yml to recreate)
.env
.venv
env/
venv/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS-generated files
.DS_Store
Thumbs.db
*.swp
*~

# Auto-generated PDF copies of manuscript figures (created by 08 and 09)
manuscript_figures/

# Legacy figure outputs (regenerate via scripts)
results/
*.csv
version-2_integrated/temp/

# Log files
*.log

# Generated at runtime (machine-specific)
SESSION_INFO.txt

# Zenodo upload archive (not for git)
*.tar.gz

# FAPROTAX installer (download separately)
FAPROTAX_*.zip

# IDE
.vscode/
.idea/

# ==========================================
# Files to TRACK (whitelist important outputs)
# ==========================================
# Exported TSV tables (small, needed for analysis)
!version-2_integrated/exported_table_clean/feature-table.tsv
!version-2_integrated/exported_table_space/feature-table.tsv
!version-2_integrated/exported_table_terrestrial/feature-table.tsv
!version-2_integrated/exported_taxonomy/taxonomy.tsv
!version-2_integrated/exported_diversity/alpha-diversity.tsv
!version-2_integrated/exported_diversity/shannon.tsv
!version-2_integrated/exported_diversity/ordination.txt
!version-2_integrated/integrated_metadata.tsv
!version-2_integrated/exported_table_raw/feature-table.tsv
!version-2_integrated/exported_denoising_stats/stats.tsv
!version-2_integrated/picrust2_out/pathways_out/path_abun_unstrat.tsv.gz
!version-2_integrated/metacyc_pathways_info.txt.gz

# Snapshot exclusions (2026-10)
**/*.qza
**/*.qzv
**/picrust2_out/intermediate/
*.RData
Rplots.pdf
.pytest_cache/
.claude/
manuscript_aa/
